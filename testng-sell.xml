<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  MagicBricks Suite - Sell Module (Case Study 1)
  Executes Sell tests separately and generates:
  - reports/TestReport_Sell.html
-->
<suite name="MagicBricks Sell Module Suite" parallel="none" verbose="2">

    <listeners>
        <listener class-name="com.magicbricks.listeners.ExtentReportListener" />
    </listeners>

    <test name="Sell Page Module Tests" preserve-order="true">
        <groups>
            <define name="all-sell">
                <include name="sell" />
                <include name="smoke" />
                <include name="regression" />
            </define>
        </groups>
        <classes>
            <class name="com.magicbricks.tests.SellPageTest" />
        </classes>
    </test>

</suite>
