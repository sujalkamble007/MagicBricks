<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<!--
  MagicBricks Automation Framework - TestNG Suite Configuration
  
  Parallel Execution Scaffolding:
  - Currently set to parallel="none" for stable, sequential local execution where the tester
    can visibly follow browser actions smoothly one by one.
  - To enable class-level parallel execution in multi-browser environments:
      change parallel="none" to parallel="classes" and adjust thread-count as needed.
  - To enable method-level parallel execution:
      change parallel="none" to parallel="methods".
-->
<suite name="MagicBricks Automation Suite" parallel="none" thread-count="2" verbose="2">

    <!-- Listeners for ExtentReports and Screenshot Logging -->
    <listeners>
        <listener class-name="com.magicbricks.listeners.ExtentReportListener" />
    </listeners>

    <test name="Home Page Module Tests" preserve-order="true">
        <groups>
            <define name="all-homepage">
                <include name="homepage" />
                <include name="smoke" />
                <include name="regression" />
            </define>
        </groups>
        <classes>
            <class name="com.magicbricks.tests.HomePageTest" />
        </classes>
    </test>

    <test name="Login Module Tests" preserve-order="true">
        <groups>
            <define name="all-login">
                <include name="login" />
                <include name="smoke" />
                <include name="regression" />
            </define>
        </groups>
        <classes>
            <class name="com.magicbricks.tests.LoginTest" />
        </classes>
    </test>

    <test name="Sell Page Module Tests" preserve-order="true">
        <groups>
            <define name="all-sell">
                <include name="sell" />
                <include name="smoke" />
                <include name="regression" />
            </define>
        </groups>
        <classes>
            <class name="com.magicbricks.tests.SellPageTest" />
        </classes>
    </test>

</suite>
