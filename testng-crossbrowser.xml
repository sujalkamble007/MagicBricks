<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MagicBricks Cross-Browser Automation Suite" parallel="tests" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.magicbricks.listeners.ExtentReportListener" />
    </listeners>

    <!-- Chrome Browser Test Node -->
    <test name="Chrome Execution">
        <parameter name="browser" value="chrome" />
        <classes>
            <class name="com.magicbricks.tests.HomePageTest" />
            <class name="com.magicbricks.tests.LoginTest" />
            <class name="com.magicbricks.tests.SellPageTest" />
        </classes>
    </test>

    <!-- Firefox Browser Test Node -->
    <test name="Firefox Execution">
        <parameter name="browser" value="firefox" />
        <classes>
            <class name="com.magicbricks.tests.HomePageTest" />
            <class name="com.magicbricks.tests.LoginTest" />
            <class name="com.magicbricks.tests.SellPageTest" />
        </classes>
    </test>

    <!-- Edge Browser Test Node -->
    <test name="Edge Execution">
        <parameter name="browser" value="edge" />
        <classes>
            <class name="com.magicbricks.tests.HomePageTest" />
            <class name="com.magicbricks.tests.LoginTest" />
            <class name="com.magicbricks.tests.SellPageTest" />
        </classes>
    </test>

</suite>
