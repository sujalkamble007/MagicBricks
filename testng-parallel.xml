<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="MagicBricks Parallel Automation Suite" parallel="classes" thread-count="3" verbose="1">

    <listeners>
        <listener class-name="com.magicbricks.listeners.ExtentReportListener" />
    </listeners>

    <test name="Parallel Class Execution">
        <classes>
            <class name="com.magicbricks.tests.HomePageTest" />
            <class name="com.magicbricks.tests.LoginTest" />
            <class name="com.magicbricks.tests.SellPageTest" />
        </classes>
    </test>

</suite>
